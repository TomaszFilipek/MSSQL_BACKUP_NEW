@page "/jobs"
@using MssqlBackup.Web.Models
@using MssqlBackup.Web.Services
@using Microsoft.AspNetCore.SignalR.Client
@inject BackupJobService JobService
@inject BackupApiService Api
@implements IAsyncDisposable

<PageTitle>MSSQL Backup - Status Konsoli</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Status konsoli (live)</h3>
    <div class="d-flex align-items-center gap-2">
        <span class="@(_isConnected ? "status-connected" : "status-disconnected")">
            <span class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></span>
            @(_isConnected ? "Live" : "Offline")
        </span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadData">Odśwież</button>
    </div>
</div>

@if (_loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Ładowanie...</span>
        </div>
    </div>
}
else
{
    <h5 class="mb-3">
        Aktywne zadania
        <span class="badge bg-primary ms-2">@_activeJobs.Count</span>
    </h5>

    @if (!_activeJobs.Any())
    {
        <div class="alert alert-info">Brak aktywnych zadań - żadna instancja konsoli nie pracuje.</div>
    }
    else
    {
        <div class="row g-3 mb-4">
            @foreach (var job in _activeJobs.OrderByDescending(j => j.StartedAt))
            {
                var progress = job.TotalDatabases > 0 ? (job.CompletedCount + job.FailedCount) * 100 / job.TotalDatabases : 0;
                var elapsed = DateTime.UtcNow - job.StartedAt;
                var isExpanded = _expandedJobs.Contains(job.Id);
                var filteredDbs = GetFilteredDatabases(job);
                <div class="col-md-6 col-xl-4">
                    <div class="card border-primary h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span>
                                <span class="badge bg-info me-1">@job.EnvironmentName</span>
                                @if (!string.IsNullOrEmpty(job.ServerName))
                                {
                                    <span class="badge bg-dark me-1" title="@job.InstanceName">@job.ServerName</span>
                                }
                                else
                                {
                                    <strong>@job.InstanceName</strong>
                                }
                            </span>
                            <span class="badge bg-success">
                                <span class="spinner-grow spinner-grow-sm me-1" style="width:0.6rem;height:0.6rem;"></span>
                                @job.Status
                            </span>
                        </div>
                        <div class="card-body">
                            <div class="small text-muted mb-2">Host: @job.HostName | Start: @TimeHelper.ToWarsawTime(job.StartedAt).ToString("HH:mm:ss")</div>
                            @if (job.TotalServers > 1)
                            {
                                <div class="small mb-2">
                                    <span class="badge bg-secondary">Serwer: @job.ServerName (@job.ServerIndex/@job.TotalServers)</span>
                                    <div class="progress mt-1" style="height: 4px;">
                                        <div class="progress-bar bg-info" style="width: @(job.ServerIndex * 100 / job.TotalServers)%"></div>
                                    </div>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(job.ServerName) && job.ServerName != job.InstanceName)
                            {
                                <div class="small text-muted mb-2">Serwer: <strong>@job.ServerName</strong> <span class="text-muted">(@job.InstanceName)</span></div>
                            }
                            <div class="mb-2">
                                <div class="d-flex justify-content-between small">
                                    <span>Postęp: @job.CompletedCount/@job.TotalDatabases</span>
                                    <span class="text-danger">@(job.FailedCount > 0 ? $"błędów: {job.FailedCount}" : "")</span>
                                    <span>@progress%</span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-success" style="width: @progress%"></div>
                                </div>
                            </div>
                            <div class="mb-1">
                                <small class="text-muted">Baza:</small>
                                <strong>@(job.CurrentDatabase ?? "-")</strong>
                            </div>
                            <div class="mb-1">
                                <small class="text-muted">Krok:</small>
                                <span class="badge bg-secondary">@(job.CurrentStep ?? "-")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(job.Message))
                            {
                                <div class="small text-muted mt-2" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@job.Message">@job.Message</div>
                            }
                            <div class="small text-muted mt-2">Czas: @elapsed.ToString(@"hh\:mm\:ss") | Aktualizacja: @TimeHelper.ToWarsawTime(job.UpdatedAt).ToString("HH:mm:ss")</div>
                            @{
                                var staleMin = (DateTime.UtcNow - job.UpdatedAt).TotalMinutes;
                            }
                            @if (staleMin > 5)
                            {
                                <div class="mt-2">
                                    <span class="badge @(staleMin > 10 ? "bg-danger" : "bg-warning text-dark")">Brak raportowania od @((int)staleMin) min @(staleMin > 10 ? "- zostanie oznaczone jako Failed" : "")</span>
                                </div>
                            }

                            <button class="btn btn-sm @(isExpanded ? "btn-secondary" : "btn-outline-primary") mt-3 w-100" @onclick="() => ToggleDatabases(job.Id)">
                                @(isExpanded ? "Ukryj bazy" : $"Bazy ({job.Databases?.Count ?? job.TotalDatabases})")
                                <span class="ms-1">@(isExpanded ? "▲" : "▼")</span>
                            </button>

                            @if (isExpanded)
                            {
                                var dbs = job.Databases ?? [];
                                <div class="mt-3">
                                    @if (dbs.Count == 0)
                                    {
                                        <div class="alert alert-warning small py-2 mb-2">Brak szczegółów - zadanie sprzed aktualizacji lub dane nie zostały wysłane.</div>
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control form-control-sm mb-2" placeholder="Filtruj bazę..."
                                               value="@GetSearchTerm(job.Id)"
                                               @oninput="(e) => SetSearchTerm(job.Id, e.Value?.ToString())" />
                                        <div class="small text-muted mb-1">Wyświetlanie @filteredDbs.Count z @dbs.Count</div>
                                        <div style="max-height: 300px; overflow-y: auto;" class="border rounded">
                                            <table class="table table-sm table-hover mb-0 small">
                                                <thead class="table-light" style="position: sticky; top: 0;">
                                                    <tr>
                                                        <th>Baza</th>
                                                        <th>Status</th>
                                                        <th>Rozmiar</th>
                                                        <th>Czas</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var db in filteredDbs.Take(200))
                                                    {
                                                        var badge = db.Status switch
                                                        {
                                                            "Completed" => "bg-success",
                                                            "Failed" => "bg-danger",
                                                            "Running" => "bg-primary",
                                                            "Pending" => "bg-secondary",
                                                            _ => "bg-light text-dark"
                                                        };
                                                        <tr>
                                                            <td title="@db.DatabaseName" style="max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@db.DatabaseName</td>
                                                            <td><span class="badge @badge" style="font-size: 0.65rem;">@db.Status</span></td>
                                                            <td>@(db.FileSize > 0 ? FormatSize(db.FileSize) : "-")</td>
                                                            <td>@(db.DurationSeconds > 0 ? $"{db.DurationSeconds:F1}s" : "-")</td>
                                                        </tr>
                                                        @if (db.Status == "Failed" && !string.IsNullOrEmpty(db.ErrorMessage))
                                                        {
                                                            <tr><td colspan="4" class="text-danger small" style="white-space: normal;">@db.ErrorMessage</td></tr>
                                                        }
                                                    }
                                                    @if (filteredDbs.Count > 200)
                                                    {
                                                        <tr><td colspan="4" class="text-center text-muted">... i @(filteredDbs.Count - 200) więcej (użyj filtra)</td></tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <h5 class="mb-3 mt-4">Ostatnie zadania</h5>

    <div class="filter-bar">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small">Środowisko</label>
                <select class="form-select form-select-sm" @bind="_filterEnv" @bind:after="ApplyFilter">
                    <option value="">Wszystkie</option>
                    @foreach (var env in _environments)
                    {
                        <option value="@env">@env</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Status</label>
                <select class="form-select form-select-sm" @bind="_filterStatus" @bind:after="ApplyFilter">
                    <option value="">Wszystkie</option>
                    <option value="Running">Running</option>
                    <option value="Completed">Completed</option>
                    <option value="CompletedWithErrors">CompletedWithErrors</option>
                    <option value="Failed">Failed</option>
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-sm btn-outline-secondary" @onclick="ResetFilter">Wyczyść</button>
            </div>
        </div>
    </div>

    <div class="table-container">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Start</th>
                    <th>Środowisko</th>
                    <th>Serwer</th>
                    <th>Instancja</th>
                    <th>Host</th>
                    <th>Status</th>
                    <th>Bazy</th>
                    <th></th>
                    <th>Czas</th>
                    <th>Info</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in _filteredJobs)
                {
                    var statusClass = job.Status switch
                    {
                        "Running" => "bg-primary",
                        "Completed" => "bg-success",
                        "CompletedWithErrors" => "bg-warning text-dark",
                        "Failed" => "bg-danger",
                        _ => "bg-secondary"
                    };
                    var duration = job.FinishedAt.HasValue ? job.FinishedAt.Value - job.StartedAt : DateTime.UtcNow - job.StartedAt;
                    var isExp = _expandedJobs.Contains(job.Id);
                    var filteredDbs = GetFilteredDatabases(job);
                    var staleHistMin = (DateTime.UtcNow - job.UpdatedAt).TotalMinutes;
                    var staleHist = job.Status == "Running" && staleHistMin > 5;
                    <tr class="@(staleHist ? "table-warning" : job.Status == "Running" ? "table-primary" : "")" title="@(staleHist ? $"Brak raportowania od {(int)staleHistMin} min" : "")">
                        <td class="text-nowrap">@TimeHelper.ToWarsawTime(job.StartedAt).ToString("dd.MM HH:mm:ss")</td>
                        <td><span class="badge bg-info">@job.EnvironmentName</span></td>
                        <td>
                            @if (!string.IsNullOrEmpty(job.ServerName))
                            {
                                <span title="@job.InstanceName">@job.ServerName</span>
                                @if (job.TotalServers > 1)
                                {
                                    <small class="text-muted">(@job.ServerIndex/@job.TotalServers)</small>
                                }
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="small">@job.InstanceName</td>
                        <td class="small text-muted">@job.HostName</td>
                        <td><span class="badge @statusClass">@job.Status</span></td>
                        <td>@job.CompletedCount/@job.TotalDatabases (@job.FailedCount err)</td>
                        <td>
                            @if ((job.Databases?.Count ?? 0) > 0)
                            {
                                <button class="btn btn-sm @(isExp ? "btn-secondary" : "btn-outline-primary")" style="font-size: 0.7rem; padding: 0.1rem 0.4rem;" @onclick="() => ToggleDatabases(job.Id)">
                                    @(isExp ? "Ukryj" : $"{job.Databases!.Count}")
                                </button>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>@duration.ToString(@"hh\:mm\:ss")</td>
                        <td class="small" title="@job.Message">@(job.Message?.Length > 40 ? job.Message[..40] + "..." : job.Message)</td>
                    </tr>
                    @if (isExp)
                    {
                        <tr>
                            <td colspan="10" class="p-0">
                                <div class="p-3 bg-light">
                                    @if ((job.Databases?.Count ?? 0) == 0)
                                    {
                                        <div class="text-muted small">Brak szczegółów baz dla tego zadania.</div>
                                    }
                                    else
                                    {
                                        <div class="d-flex gap-2 mb-2 align-items-center">
                                            <input type="text" class="form-control form-control-sm" style="max-width: 250px;" placeholder="Filtruj bazę..."
                                                   value="@GetSearchTerm(job.Id)"
                                                   @oninput="(e) => SetSearchTerm(job.Id, e.Value?.ToString())" />
                                            <small class="text-muted">Wyświetlanie @filteredDbs.Count z @job.Databases!.Count</small>
                                        </div>
                                        <div style="max-height: 350px; overflow-y: auto;" class="border rounded bg-white">
                                            <table class="table table-sm table-hover mb-0 small">
                                                <thead class="table-light" style="position: sticky; top: 0;">
                                                    <tr>
                                                        <th>Baza</th>
                                                        <th>Status</th>
                                                        <th>Rozmiar</th>
                                                        <th>Czas</th>
                                                        <th>Błąd</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var db in filteredDbs.Take(300))
                                                    {
                                                        var badge = db.Status switch
                                                        {
                                                            "Completed" => "bg-success",
                                                            "Failed" => "bg-danger",
                                                            "Running" => "bg-primary",
                                                            "Pending" => "bg-secondary",
                                                            _ => "bg-light text-dark"
                                                        };
                                                        <tr>
                                                            <td style="max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@db.DatabaseName">@db.DatabaseName</td>
                                                            <td><span class="badge @badge" style="font-size: 0.65rem;">@db.Status</span></td>
                                                            <td>@(db.FileSize > 0 ? FormatSize(db.FileSize) : "-")</td>
                                                            <td>@(db.DurationSeconds > 0 ? $"{db.DurationSeconds:F1}s" : "-")</td>
                                                            <td class="text-danger" style="max-width: 250px; white-space: normal; word-break: break-word;">@(db.ErrorMessage ?? "-")</td>
                                                        </tr>
                                                    }
                                                    @if (filteredDbs.Count > 300)
                                                    {
                                                        <tr><td colspan="5" class="text-center text-muted">... i @(filteredDbs.Count - 300) więcej - zawęź filtrem</td></tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                @if (!_filteredJobs.Any())
                {
                    <tr><td colspan="10" class="text-center text-muted py-3">Brak zadań</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<BackupJobDto> _allJobs = [];
    private List<BackupJobDto> _activeJobs = [];
    private List<BackupJobDto> _filteredJobs = [];
    private List<string> _environments = [];
    private string? _filterEnv;
    private string? _filterStatus;
    private bool _loading = true;
    private bool _isConnected;
    private HubConnection? _hubConnection;
    private HashSet<Guid> _expandedJobs = [];
    private Dictionary<Guid, string> _dbSearch = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await SetupSignalR();
    }

    private async Task LoadData()
    {
        _loading = true;
        _allJobs = await JobService.GetRecentAsync(100);
        _environments = _allJobs.Select(j => j.EnvironmentName).Distinct().OrderBy(e => e).ToList();
        UpdateLists();
        _loading = false;
    }

    private void UpdateLists()
    {
        _activeJobs = _allJobs.Where(j => j.Status == "Running").ToList();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var q = _allJobs.AsEnumerable();
        if (!string.IsNullOrEmpty(_filterEnv))
            q = q.Where(j => j.EnvironmentName == _filterEnv);
        if (!string.IsNullOrEmpty(_filterStatus))
            q = q.Where(j => j.Status == _filterStatus);
        _filteredJobs = q.OrderByDescending(j => j.StartedAt).Take(50).ToList();
    }

    private void ResetFilter()
    {
        _filterEnv = null;
        _filterStatus = null;
        ApplyFilter();
    }

    private void ToggleDatabases(Guid id)
    {
        if (!_expandedJobs.Add(id))
            _expandedJobs.Remove(id);
    }

    private string GetSearchTerm(Guid id) => _dbSearch.TryGetValue(id, out var v) ? v : string.Empty;
    private void SetSearchTerm(Guid id, string? term) => _dbSearch[id] = term ?? string.Empty;

    private List<BackupJobDatabaseInfo> GetFilteredDatabases(BackupJobDto job)
    {
        var list = job.Databases ?? [];
        if (!_dbSearch.TryGetValue(job.Id, out var term) || string.IsNullOrWhiteSpace(term))
            return list;
        return list.Where(d => d.DatabaseName.Contains(term, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F2} GB";
    }

    private async Task SetupSignalR()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(JobService.HubUrl)
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<BackupJobDto>("JobCreated", async (job) =>
            {
                _allJobs.RemoveAll(j => j.Id == job.Id);
                _allJobs.Insert(0, job);
                UpdateLists();
                await InvokeAsync(StateHasChanged);
            });

            _hubConnection.On<BackupJobDto>("JobUpdated", async (job) =>
            {
                var idx = _allJobs.FindIndex(j => j.Id == job.Id);
                if (idx >= 0) _allJobs[idx] = job;
                else _allJobs.Insert(0, job);
                UpdateLists();
                await InvokeAsync(StateHasChanged);
            });

            _hubConnection.On<BackupJobDto>("JobFinished", async (job) =>
            {
                var idx = _allJobs.FindIndex(j => j.Id == job.Id);
                if (idx >= 0) _allJobs[idx] = job;
                else _allJobs.Insert(0, job);
                UpdateLists();
                await InvokeAsync(StateHasChanged);
            });

            _hubConnection.Reconnecting += _ => { _isConnected = false; return InvokeAsync(StateHasChanged); };
            _hubConnection.Reconnected += _ => { _isConnected = true; return InvokeAsync(StateHasChanged); };

            await _hubConnection.StartAsync();
            _isConnected = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR jobs failed: {ex.Message}");
            _isConnected = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null) await _hubConnection.DisposeAsync();
    }
}
